    <div class="mxgraph" style="max-width:100%;border:1px solid transparent;" data-mxgraph="{&quot;highlight&quot;:&quot;#0000ff&quot;,&quot;nav&quot;:true,&quot;resize&quot;:true,&quot;toolbar&quot;:&quot;zoom layers tags lightbox&quot;,&quot;edit&quot;:&quot;_blank&quot;,&quot;xml&quot;:&quot;&lt;mxfile host=\&quot;Electron\&quot; agent=\&quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.8 Chrome/128.0.6613.36 Electron/32.0.1 Safari/537.36\&quot; version=\&quot;24.7.8\&quot;&gt;\n  &lt;diagram name=\&quot;Страница — 1\&quot; id=\&quot;5sThAkj1In6MHoOHoBf7\&quot;&gt;\n    &lt;mxGraphModel dx=\&quot;5610\&quot; dy=\&quot;2411\&quot; grid=\&quot;1\&quot; gridSize=\&quot;10\&quot; guides=\&quot;1\&quot; tooltips=\&quot;1\&quot; connect=\&quot;1\&quot; arrows=\&quot;1\&quot; fold=\&quot;1\&quot; page=\&quot;1\&quot; pageScale=\&quot;1\&quot; pageWidth=\&quot;827\&quot; pageHeight=\&quot;1169\&quot; math=\&quot;0\&quot; shadow=\&quot;0\&quot;&gt;\n      &lt;root&gt;\n        &lt;mxCell id=\&quot;0\&quot; /&gt;\n        &lt;mxCell id=\&quot;1\&quot; parent=\&quot;0\&quot; /&gt;\n        &lt;mxCell id=\&quot;ObTWQqiKvv_k-rUW5Yz--1\&quot; value=\&quot;\&quot; style=\&quot;html=1;whiteSpace=wrap;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;405\&quot; y=\&quot;690\&quot; width=\&quot;861\&quot; height=\&quot;410\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-146\&quot; value=\&quot;\&quot; style=\&quot;html=1;whiteSpace=wrap;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;395\&quot; y=\&quot;190\&quot; width=\&quot;740\&quot; height=\&quot;410\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-1\&quot; value=\&quot;&amp;lt;h2 class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;1. Ассоциация (Association)&amp;lt;/h2&amp;gt;&amp;lt;h2 class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal;&amp;quot;&amp;gt;Самый базовый тип связи, показывающий,&amp;amp;nbsp;&amp;lt;/span&amp;gt;&amp;lt;/h2&amp;gt;&amp;lt;h2 style=&amp;quot;margin-top: 12px;&amp;quot; class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal; line-height: 70%;&amp;quot;&amp;gt;что актер взаимодействует со сценарием использования.&amp;lt;/span&amp;gt;&amp;lt;/h2&amp;gt;\&quot; style=\&quot;text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;-710\&quot; y=\&quot;485\&quot; width=\&quot;350\&quot; height=\&quot;140\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-2\&quot; value=\&quot;&amp;lt;h2 style=&amp;quot;&amp;quot; class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;2. Включение (Include)&amp;lt;/h2&amp;gt;&amp;lt;p class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;Отношение, при котором один сценарий (базовый) &amp;lt;b&amp;gt;ОБЯЗАТЕЛЬНО&amp;lt;/b&amp;gt;&amp;amp;nbsp;&amp;lt;/p&amp;gt;&amp;lt;p style=&amp;quot;&amp;quot; class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;включает функциональность другого (включаемого) сценария в свою работу.&amp;lt;/p&amp;gt;&amp;lt;p style=&amp;quot;&amp;quot; class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&amp;quot;&amp;gt;Пунктирная стрелка от базового сценария к включаемому с надписью «include».&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;\&quot; style=\&quot;text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;-710\&quot; y=\&quot;600\&quot; width=\&quot;470\&quot; height=\&quot;140\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-3\&quot; value=\&quot;&amp;lt;h2 class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;3. Расширение (Extend)&amp;lt;/h2&amp;gt;&amp;lt;p style=&amp;quot;&amp;quot; class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;Отношение, при котором один сценарий (расширяющий)&amp;amp;nbsp;&amp;lt;/p&amp;gt;&amp;lt;p style=&amp;quot;&amp;quot; class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;&amp;lt;b&amp;gt;МОЖЕТ&amp;lt;/b&amp;gt; добавить свою функциональность к другому (базовому) сценарию при определенных условиях.&amp;lt;/p&amp;gt;&amp;lt;p style=&amp;quot;&amp;quot; class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&amp;quot;&amp;gt;Пунктирная стрелка от расширяющего сценария к базовому с надписью «extend».&amp;lt;/span&amp;gt;&amp;lt;/p&amp;gt;\&quot; style=\&quot;text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;-710\&quot; y=\&quot;740\&quot; width=\&quot;610\&quot; height=\&quot;140\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-4\&quot; value=\&quot;&amp;lt;h2 class=&amp;quot;text-xl font-bold text-text-100 mt-1 -mb-0.5&amp;quot;&amp;gt;4. Обобщение/наследование (Generalization)&amp;lt;/h2&amp;gt;&amp;lt;p class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;Отношение, показывающее, что один элемент&amp;amp;nbsp;&amp;lt;/p&amp;gt;&amp;lt;p class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;(дочерний) является специализированной версией другого (родительского).&amp;lt;/p&amp;gt;&amp;lt;p class=&amp;quot;whitespace-pre-wrap break-words&amp;quot;&amp;gt;&amp;quot;ЯВЛЯЕТСЯ разновидностью&amp;quot; (is-a relationship)&amp;lt;/p&amp;gt;\&quot; style=\&quot;text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;-710\&quot; y=\&quot;880\&quot; width=\&quot;450\&quot; height=\&quot;140\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-153\&quot; style=\&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;startFill=0;\&quot; parent=\&quot;1\&quot; source=\&quot;0t84jGqxNBHPS0U8xIDs-142\&quot; target=\&quot;okgxVH7EojtN_QWpu5Ca-6\&quot; edge=\&quot;1\&quot;&gt;\n          &lt;mxGeometry relative=\&quot;1\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-154\&quot; style=\&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=none;startFill=0;\&quot; parent=\&quot;1\&quot; source=\&quot;0t84jGqxNBHPS0U8xIDs-142\&quot; target=\&quot;okgxVH7EojtN_QWpu5Ca-4\&quot; edge=\&quot;1\&quot;&gt;\n          &lt;mxGeometry relative=\&quot;1\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-142\&quot; value=\&quot;Неавторизованный&amp;lt;div&amp;gt;пользователь&amp;lt;/div&amp;gt;\&quot; style=\&quot;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;265\&quot; y=\&quot;335\&quot; width=\&quot;30\&quot; height=\&quot;60\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-147\&quot; value=\&quot;После авторизации пользователь получит роль судьи или преподавателя&amp;amp;nbsp;\&quot; style=\&quot;html=1;dropTarget=0;whiteSpace=wrap;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;-15\&quot; y=\&quot;335\&quot; width=\&quot;180\&quot; height=\&quot;90\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-157\&quot; style=\&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;endArrow=none;startFill=0;\&quot; parent=\&quot;1\&quot; source=\&quot;okgxVH7EojtN_QWpu5Ca-3\&quot; target=\&quot;0t84jGqxNBHPS0U8xIDs-156\&quot; edge=\&quot;1\&quot;&gt;\n          &lt;mxGeometry relative=\&quot;1\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;okgxVH7EojtN_QWpu5Ca-3\&quot; value=\&quot;Заполнить анкету\&quot; style=\&quot;ellipse;whiteSpace=wrap;html=1;\&quot; parent=\&quot;1\&quot; vertex=\&quot;1\&quot;&gt;\n          &lt;mxGeometry x=\&quot;680\&quot; y=\&quot;260\&quot; width=\&quot;165\&quot; height=\&quot;80\&quot; as=\&quot;geometry\&quot; /&gt;\n        &lt;/mxCell&gt;\n        &lt;mxCell id=\&quot;0t84jGqxNBHPS0U8xIDs-155\&quot; style=\&quot;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;\&quot; parent=\&quot;1\&quot; source=\&quot;okgxVH7EojtN_QWpu5Ca-4\&quot; target=\&quot;okgxVH7EojtN_QWpu5Ca-5\&quot; edge=\&quot;1\&quot;&gt;\n          &lt;mxGeometry relative=\&quot;1\&quot;